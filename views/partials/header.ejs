<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Private video sharing for your community' %>">
  <title><%= title %> — <%= siteName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% if (currentUser) { %>
  <nav class="navbar" id="main-nav">
    <div class="nav-inner">
      <a href="/videos" class="nav-logo" id="nav-logo">
        <span class="logo-icon">▶</span>
        <span class="logo-text"><%= siteName %></span>
      </a>

      <form action="/videos" method="GET" class="nav-search" id="search-form">
        <div class="search-wrapper">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input type="text" name="search" placeholder="Search videos..." value="<%= typeof search !== 'undefined' ? search : '' %>" class="search-input" id="search-input">
        </div>
      </form>

      <div class="nav-actions">
        <button type="button" class="nav-icon-btn mobile-search-btn" id="mobile-search-btn" aria-label="Search videos">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>

        <a href="/videos/upload" class="btn btn-primary btn-upload" id="btn-upload">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17,8 12,3 7,8"/><line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="btn-upload-text">Upload</span>
        </a>

        <div class="nav-user-menu" id="user-menu">
          <button class="nav-avatar-btn" id="avatar-btn" aria-label="User menu">
            <% if (currentUser.avatar) { %>
              <img src="<%= helpers.avatarUrl(currentUser.avatar) %>" alt="<%= currentUser.username %>" class="nav-avatar">
            <% } else { %>
              <div class="nav-avatar nav-avatar-default"><%= currentUser.username.charAt(0).toUpperCase() %></div>
            <% } %>
          </button>
          <div class="dropdown-menu" id="dropdown-menu">
            <div class="dropdown-header">
              <span class="dropdown-username"><%= currentUser.username %></span>
              <% if (currentUser.role === 'admin') { %>
                <span class="badge badge-admin">Admin</span>
              <% } %>
            </div>
            <div class="dropdown-divider"></div>
            <a href="/users/<%= currentUser.id %>" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
              My Profile
            </a>
            <a href="/users/<%= currentUser.id %>/edit" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
              Settings
            </a>
            <% if (currentUser.role === 'admin') { %>
              <a href="/admin" class="dropdown-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                  <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                  <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                Admin Panel
              </a>
            <% } %>
            <div class="dropdown-divider"></div>
            <form action="/auth/logout" method="POST" class="dropdown-form">
              <button type="submit" class="dropdown-item dropdown-item-danger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                  <polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Log Out
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Dedicated Mobile Search Overlay -->
  <div class="mobile-search-overlay" id="mobile-search-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search videos">
    <div class="mobile-search-header">
      <button type="button" class="mobile-search-back-btn" id="mobile-search-back-btn" aria-label="Close search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="22" height="22">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
      </button>

      <form action="/videos" method="GET" class="mobile-search-form" id="mobile-search-form">
        <div class="mobile-search-input-wrap">
          <svg class="mobile-search-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            type="search"
            name="search"
            class="mobile-search-input"
            id="mobile-search-input"
            placeholder="Search videos..."
            value="<%= typeof search !== 'undefined' ? search : '' %>"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Search query"
          >
          <button type="button" class="mobile-search-clear-btn" id="mobile-search-clear-btn" aria-label="Clear search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

    <div class="mobile-search-body">
      <div class="mobile-recent-searches" id="mobile-recent-searches" style="display: none;">
        <div class="recent-searches-header">
          <span class="recent-searches-title">Recent searches</span>
          <button type="button" class="recent-clear-all-btn" id="recent-clear-all-btn">Clear all</button>
        </div>
        <ul class="recent-searches-list" id="recent-searches-list"></ul>
      </div>
    </div>
  </div>
  <% } %>

  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="flash flash-success" id="flash-message">
      <span><%= successMessage %></span>
      <button class="flash-close" onclick="this.parentElement.remove()">×</button>
    </div>
  <% } %>
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="flash flash-error" id="flash-message">
      <span><%= errorMessage %></span>
      <button class="flash-close" onclick="this.parentElement.remove()">×</button>
    </div>
  <% } %>

  <main class="main-content">
