<%- include('../partials/header') %>

<div class="container container-sm">
  <div class="page-header">
    <h1 class="page-title">Edit Profile</h1>
  </div>

  <% if (errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(err => { %>
        <p class="form-error"><%= err.msg %></p>
      <% }) %>
    </div>
  <% } %>

  <form action="/users/<%= profileUser.id %>/edit" method="POST" class="edit-form" id="edit-profile-form">
    <!-- Avatar Upload -->
    <div class="avatar-upload-section">
      <div class="avatar-upload-preview">
        <% if (profileUser.avatar) { %>
          <img src="<%= helpers.avatarUrl(profileUser.avatar) %>" alt="<%= profileUser.username %>" class="avatar-upload-img" id="avatar-preview">
        <% } else { %>
          <div class="avatar-default avatar-lg" id="avatar-preview"><%= profileUser.username.charAt(0).toUpperCase() %></div>
        <% } %>
      </div>
      <div class="avatar-upload-controls">
        <label for="avatar" class="btn btn-ghost btn-sm">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
          </svg>
          Change Avatar
        </label>
        <input type="file" id="avatar" name="avatar" accept="image/*" class="hidden-input">
        <p class="form-hint">JPG, PNG, WebP, GIF — up to 5MB</p>
      </div>
    </div>

    <div class="form-group">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" value="<%= profileUser.username %>" required minlength="3" maxlength="30" pattern="[a-zA-Z0-9_-]+">
    </div>

    <div class="form-group">
      <label for="bio">Bio</label>
      <textarea id="bio" name="bio" placeholder="Tell us about yourself" rows="3" maxlength="500"><%= profileUser.bio || '' %></textarea>
    </div>

    <div class="form-actions">
      <a href="/users/<%= profileUser.id %>" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary" id="btn-save-profile">Save Changes</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
