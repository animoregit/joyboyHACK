<%- include('../partials/header') %>

<div class="container container-sm">
  <div class="page-header">
    <h1 class="page-title">Upload Video</h1>
  </div>

  <% if (errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(err => { %>
        <p class="form-error"><%= err.msg %></p>
      <% }) %>
    </div>
  <% } %>

  <form action="/videos/upload" method="POST" enctype="multipart/form-data" class="upload-form" id="upload-form">
    <!-- Drag & Drop Zone -->
    <div class="drop-zone" id="drop-zone">
      <div class="drop-zone-content">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" class="drop-icon">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17,8 12,3 7,8"/><line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <p class="drop-text">Drag & drop your video here</p>
        <p class="drop-hint">or click to browse files</p>
        <p class="drop-formats">MP4 or WebM — up to 50MB</p>
      </div>
      <input type="file" name="video" id="video-input" accept="video/*" class="drop-input" required>
    </div>

    <!-- File preview -->
    <div class="file-preview" id="file-preview" style="display: none;">
      <div class="file-preview-info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
          <polygon points="23 7 16 12 23 17 23 7"/>
          <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
        </svg>
        <span id="file-name"></span>
        <span id="file-size" class="text-muted"></span>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" id="file-remove">Remove</button>
    </div>

    <!-- Upload Progress -->
    <div class="progress-container" id="progress-container" style="display: none;">
      <div class="progress-bar">
        <div class="progress-fill" id="progress-fill"></div>
      </div>
      <span class="progress-text" id="progress-text">0%</span>
    </div>

    <!-- Video Details -->
    <div class="form-group">
      <label for="title">Title <span class="required">*</span></label>
      <input type="text" id="title" name="title" placeholder="Give your video a title" required maxlength="200">
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" placeholder="Tell viewers about your video" rows="4" maxlength="5000"></textarea>
    </div>

    <div class="form-group">
      <label for="visibility">Visibility</label>
      <select id="visibility" name="visibility" class="form-select">
        <option value="public">Public — Visible to all members</option>
        <option value="private">Private — Only you and admins</option>
      </select>
    </div>

    <div class="form-actions">
      <a href="/videos" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary" id="btn-upload-submit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17,8 12,3 7,8"/><line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        Upload Video
      </button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
